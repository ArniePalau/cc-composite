{% extends '@Forumify/admin/base.html.twig' %}

{% block title_page %}Layer permissions{% endblock %}

{% block body %}
    <div class="box">
        <h2 class="box-title">{{ layer.filename }}</h2>
        <div class="box-content grid grid-cols-1 md:grid-cols-3 gap-6">
            <div class="bg-base-200 rounded p-4">
                <img src="{{ asset(layer.assetPath, 'cc_composite.asset') }}" alt="{{ layer.filename }}" style="width:100%;height:auto">
                <p class="mt-3">Category: {{ layer.category.label }}</p>
            </div>
            <div class="md:col-span-2">
                {{ form_start(form) }}
                {{ form_rest(form) }}
                <div class="flex gap-2 mt-4">
                    <button class="btn-primary" type="submit">Save permissions</button>
                    <a class="btn-secondary" href="{{ path('cc_composite_admin_layers_index') }}">Cancel</a>
                </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
{% endblock %}
