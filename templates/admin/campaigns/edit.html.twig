{% extends '@Forumify/admin/base.html.twig' %}
{% block title_page %}Edit campaign{% endblock %}
{% block body %}<div class="box"><h2 class="box-title">{{ campaign.name }}</h2><div class="box-content">{{ form_start(form) }}{{ form_row(form.name) }}{{ form_row(form.description) }}<div class="flex gap-3 mt-4"><button class="btn-primary" type="submit">Save changes</button><a class="btn-secondary" href="{{ path('cc_composite_admin_campaigns_index') }}">Cancel</a></div>{{ form_rest(form) }}{{ form_end(form) }}</div></div>{% endblock %}
