{% extends '@Forumify/admin/base.html.twig' %}

{% block title_page %}CC Composite award layout{% endblock %}

{% block body %}
    <form method="post">
        <input type="hidden" name="_token" value="{{ csrf_token('cc-composite-awards') }}">
        <div class="box">
            <h2 class="box-title">Award panel categories</h2>
            <div class="box-content overflow-x-auto">
                <table class="table w-full">
                    <thead><tr><th>Award</th><th>Image</th><th>Composite category</th></tr></thead>
                    <tbody>
                    {% for award in awards %}
                        <tr>
                            <td>{{ award.name }}</td>
                            <td>{% if award.image %}<img src="{{ asset(award.image, 'perscom.asset') }}" alt="" style="max-width:100px;max-height:36px">{% endif %}</td>
                            <td>
                                <select class="form-control" name="placements[{{ award.id }}]">
                                    <option value="">Do not render</option>
                                    {% for category in categories %}
                                        <option value="{{ category.value }}" {{ placements[award.id]|default('') == category.value ? 'selected' : '' }}>{{ category.label }}</option>
                                    {% endfor %}
                                </select>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
        <button class="btn-primary mt-4" type="submit">Save award layout</button>
    </form>
{% endblock %}
