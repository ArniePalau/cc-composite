{% extends '@Forumify/admin/base.html.twig' %}

{% block title_page %}Field reports{% endblock %}

{% block body %}
    <div class="box mb-6">
        <h2 class="box-title">Automatic mission report feed</h2>
        <div class="box-content">
            <div class="flex justify-end mb-4"><a class="btn-secondary" href="{{ path('cc_composite_admin_field_report_players_index') }}"><i class="ph ph-link"></i> Link report players</a></div>
            <div class="flex justify-end mb-4"><a class="btn-secondary" href="{{ path('cc_composite_admin_campaigns_index') }}"><i class="ph ph-flag-banner"></i> Manage campaigns</a></div>
            <p class="mb-2">The plugin checks the Arma Server Manager feed every hour and imports newly available reports.</p>
            <p class="mb-4"><a class="btn-link" href="{{ feedUrl }}" target="_blank" rel="noopener noreferrer">{{ feedUrl }}</a></p>
            <p class="mb-4 text-muted">New reports are hidden by default. Reports spanning Wednesday at 23:00 or Saturday at 23:30 (Europe/Madrid) are published automatically. The visibility switch below always remains under admin control.</p>
            <form action="{{ path('cc_composite_admin_field_reports_sync') }}" method="post">
                <input type="hidden" name="_token" value="{{ csrf_token('cc-composite-field-report-sync') }}">
                <button class="btn-primary" type="submit"><i class="ph ph-arrows-clockwise"></i> Check feed now</button>
            </form>
        </div>
    </div>

    <div class="box">
        <h2 class="box-title">Imported reports</h2>
        <div class="box-content overflow-x-auto">
            <table class="w-full">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Mission</th>
                        <th>Map</th>
                        <th>Players</th>
                        <th>Visible</th>
                        <th>Campaign</th>
                        <th>Local map</th>
                        <th class="text-right">Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for report in reports %}
                    <tr>
                        <td>{{ report.startedAt|date('d/m/Y H:i') }}</td>
                        <td><a class="btn-link" href="{{ path('cc_composite_field_reports_show', {code: report.code}) }}">{{ report.missionName }}</a></td>
                        <td>{{ report.worldDisplayName|default(report.world) }}</td>
                        <td>{{ report.playerCount }}</td>
                        <td><form action="{{ path('cc_composite_admin_field_reports_visibility', {id: report.id}) }}" method="post"><input type="hidden" name="_token" value="{{ csrf_token('cc-composite-field-report-visibility-' ~ report.id) }}"><input type="hidden" name="visible" value="0"><label class="flex items-center gap-2"><input type="checkbox" name="visible" value="1" role="switch"{% if report.visible %} checked{% endif %} onchange="this.form.submit()"><span>{{ report.visible ? 'Visible' : 'Hidden' }}</span></label></form></td>
                        <td><form action="{{ path('cc_composite_admin_field_reports_campaign', {id: report.id}) }}" method="post" class="flex gap-2"><input type="hidden" name="_token" value="{{ csrf_token('cc-composite-field-report-campaign-' ~ report.id) }}"><select class="form-control" name="campaign"><option value="0">No campaign</option>{% for campaign in campaigns %}<option value="{{ campaign.id }}"{% if report.campaign and report.campaign.id == campaign.id %} selected{% endif %}>{{ campaign.name }}</option>{% endfor %}</select><button class="btn-secondary btn-small" type="submit">Save</button></form></td>
                        <td>{% if report.payload._ccMap is defined %}<span class="text-success">Live tiles</span>{% elseif report.mapPath %}<span class="text-muted">Legacy image</span>{% else %}<span class="text-muted">Unavailable</span>{% endif %}</td>
                        <td>
                            <div class="flex justify-end gap-2">
                                <form action="{{ path('cc_composite_admin_field_reports_refresh', {id: report.id}) }}" method="post">
                                    <input type="hidden" name="_token" value="{{ csrf_token('cc-composite-field-report-refresh-' ~ report.id) }}">
                                    <button class="btn-secondary btn-small" type="submit"><i class="ph ph-arrows-clockwise"></i> Refresh</button>
                                </form>
                                <form action="{{ path('cc_composite_admin_field_reports_delete', {id: report.id}) }}" method="post" onsubmit="return confirm('Delete this field report?')">
                                    <input type="hidden" name="_token" value="{{ csrf_token('cc-composite-field-report-delete-' ~ report.id) }}">
                                    <button class="btn-danger btn-small" type="submit" aria-label="Delete"><i class="ph ph-trash"></i></button>
                                </form>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="8" class="text-center p-6">No field reports have been imported yet.</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
