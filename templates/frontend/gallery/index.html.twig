{% extends '@Forumify/frontend/base.html.twig' %}

{% block title_page %}Galeria de Campanyes i Missions{% endblock %}

{% block body %}
<style>
    .cc-gallery-hero {
        position: relative;
        border-radius: 12px;
        overflow: hidden;
        margin-bottom: 2rem;
        background: linear-gradient(135deg, rgba(13, 20, 32, 0.95), rgba(7, 11, 18, 0.98));
        border: 1px solid rgba(255, 255, 255, 0.08);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
    }
    .cc-gallery-hero__bg {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        opacity: 0.25;
        filter: blur(2px);
        transform: scale(1.05);
    }
    .cc-gallery-hero__content {
        position: relative;
        z-index: 2;
        padding: 2.5rem 2rem;
    }
    .cc-gallery-tabs {
        display: flex;
        gap: 0.6rem;
        flex-wrap: wrap;
        margin-bottom: 1.5rem;
    }
    .cc-gallery-tab {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.5rem 1.1rem;
        border-radius: 9999px;
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.1);
        color: #d1d5db;
        text-decoration: none;
        font-size: 0.9rem;
        font-weight: 500;
        transition: all 0.2s ease;
    }
    .cc-gallery-tab:hover {
        background: rgba(255, 255, 255, 0.09);
        color: #fff;
        border-color: rgba(255, 255, 255, 0.25);
    }
    .cc-gallery-tab.active {
        background: #ba1e1e;
        color: #ffffff;
        border-color: #ba1e1e;
        box-shadow: 0 4px 14px rgba(186, 30, 30, 0.45);
    }
    .cc-mission-tabs {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
        margin-bottom: 2rem;
        padding: 0.75rem 1rem;
        background: rgba(0, 0, 0, 0.2);
        border-radius: 8px;
        border: 1px solid rgba(255, 255, 255, 0.05);
    }
    .cc-mission-tab {
        padding: 0.35rem 0.85rem;
        border-radius: 6px;
        font-size: 0.82rem;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.08);
        color: #9ca3af;
        text-decoration: none;
        transition: all 0.15s ease;
    }
    .cc-mission-tab:hover {
        background: rgba(255, 255, 255, 0.08);
        color: #f3f4f6;
    }
    .cc-mission-tab.active {
        background: rgba(255, 255, 255, 0.15);
        color: #fff;
        border-color: rgba(255, 255, 255, 0.3);
        font-weight: 600;
    }
    .cc-gallery-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 1.5rem;
        width: 100%;
    }
    .cc-gallery-card {
        display: flex;
        flex-direction: column;
        border-radius: 12px;
        overflow: hidden;
        background: rgba(13, 20, 32, 0.88);
        border: 1px solid rgba(229, 172, 0, 0.18);
        box-shadow: 0 4px 18px rgba(0, 0, 0, 0.35);
        transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.25s ease, border-color 0.25s ease;
        cursor: pointer;
        width: 100%;
    }
    .cc-gallery-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 12px 28px rgba(0, 0, 0, 0.55);
        border-color: rgba(229, 172, 0, 0.55);
    }
    .cc-gallery-card__media {
        position: relative;
        width: 100%;
        aspect-ratio: 16 / 9;
        overflow: hidden;
        background: #080c14;
    }
    .cc-gallery-card__img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        transition: transform 0.45s ease;
    }
    .cc-gallery-card:hover .cc-gallery-card__img {
        transform: scale(1.06);
    }
    .cc-gallery-card__overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(to top, rgba(5, 8, 15, 0.9) 0%, rgba(5, 8, 15, 0.2) 40%, transparent 70%);
        pointer-events: none;
    }
    .cc-gallery-card__media-bottom {
        position: absolute;
        bottom: 10px;
        left: 12px;
        right: 12px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 0.5rem;
        z-index: 2;
        pointer-events: none;
    }
    .cc-gallery-card__media-left,
    .cc-gallery-card__media-right {
        display: flex;
        align-items: center;
    }
    .cc-gallery-pill {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        padding: 0.25rem 0.6rem;
        border-radius: 6px;
        font-size: 0.78rem;
        font-weight: 600;
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
    }
    .cc-gallery-pill--mission {
        background: rgba(186, 30, 30, 0.85);
        border: 1px solid rgba(255, 255, 255, 0.25);
        color: #ffffff;
        max-width: 180px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .cc-gallery-pill--campaign {
        background: rgba(229, 172, 0, 0.85);
        border: 1px solid rgba(255, 255, 255, 0.25);
        color: #05080f;
        font-weight: 700;
        max-width: 180px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .cc-gallery-pill--date {
        background: rgba(0, 0, 0, 0.7);
        border: 1px solid rgba(255, 255, 255, 0.15);
        color: #e5e7eb;
        white-space: nowrap;
    }
    .cc-gallery-card__body {
        padding: 0.9rem 1.15rem;
        background: rgba(10, 14, 23, 0.95);
        border-top: 1px solid rgba(255, 255, 255, 0.06);
    }
    .cc-gallery-card__title {
        font-size: 1rem;
        font-weight: 600;
        color: #f3f4f6;
        margin: 0;
        line-height: 1.35;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .cc-gallery-title {
        font-family: var(--cdc-font-display, 'Oswald'), 'Barlow Condensed', Impact, sans-serif;
        font-size: clamp(2rem, 4vw, 2.75rem);
        font-weight: 700;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: #ffffff;
        margin: 0.25rem 0 0.5rem 0;
        line-height: 1.1;
    }
    .cc-gallery-eyebrow {
        color: var(--cc-gold, #e5ac00);
        font-family: var(--cdc-font-display, 'Oswald'), 'Barlow Condensed', Impact, sans-serif;
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

    /* Lightbox Modal */
    .cc-lightbox {
        display: none;
        position: fixed;
        inset: 0;
        z-index: 99999;
        background-color: rgba(4, 7, 12, 0.94);
        backdrop-filter: blur(14px);
        align-items: center;
        justify-content: center;
        padding: 1.5rem;
        opacity: 0;
        transition: opacity 0.25s ease;
    }
    .cc-lightbox.active {
        display: flex;
        opacity: 1;
    }
    .cc-lightbox__container {
        position: relative;
        max-width: 92vw;
        max-height: 88vh;
        display: flex;
        flex-direction: column;
        align-items: center;
    }
    .cc-lightbox__img {
        max-width: 100%;
        max-height: 78vh;
        object-fit: contain;
        border-radius: 8px;
        box-shadow: 0 0 40px rgba(0, 0, 0, 0.9);
        border: 1px solid rgba(255, 255, 255, 0.1);
    }
    .cc-lightbox__info {
        margin-top: 1rem;
        text-align: center;
        color: #f3f4f6;
    }
    .cc-lightbox__title {
        font-family: var(--cdc-font-display, 'Oswald'), 'Barlow Condensed', Impact, sans-serif;
        font-size: 1.25rem;
        font-weight: 700;
        letter-spacing: 0.03em;
        text-transform: uppercase;
        margin-bottom: 0.25rem;
    }
    .cc-lightbox__sub {
        font-size: 0.85rem;
        color: #9ca3af;
    }
    .cc-lightbox__close {
        position: absolute;
        top: 20px;
        right: 25px;
        width: 44px;
        height: 44px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.1);
        border: 1px solid rgba(255, 255, 255, 0.15);
        color: #fff;
        font-size: 24px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.2s ease;
    }
    .cc-lightbox__close:hover {
        background: #ba1e1e;
        border-color: #ba1e1e;
        transform: rotate(90deg);
    }
    .cc-lightbox__arrow {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        width: 50px;
        height: 50px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.15);
        color: #fff;
        font-size: 26px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.2s ease;
        z-index: 10;
    }
    .cc-lightbox__arrow:hover {
        background: #ba1e1e;
        border-color: #ba1e1e;
    }
    .cc-lightbox__arrow--prev { left: 25px; }
    .cc-lightbox__arrow--next { right: 25px; }
</style>

<div class="container my-6">
    <div class="cc-gallery-hero">
        {% if selectedCampaign and selectedCampaign.imagePath %}
            <img class="cc-gallery-hero__bg" src="{{ asset(selectedCampaign.imagePath, 'cc_composite.asset') }}" alt="">
        {% endif %}
        <div class="cc-gallery-hero__content">
            <div class="flex flex-wrap justify-between items-center gap-4">
                <div>
                    <div class="cc-gallery-eyebrow">
                        <i class="ph ph-images"></i> Arxiu Fotogràfic
                    </div>
                    <h1 class="cc-gallery-title">
                        {% if selectedReport %}
                            Galeria: {{ selectedReport.missionName }}
                        {% elseif selectedCampaign %}
                            Galeria: {{ selectedCampaign.name }}
                        {% else %}
                            Galeria de Campanyes i Missions
                        {% endif %}
                    </h1>
                    <p class="text-secondary max-w-3xl mb-0">
                        {% if selectedReport %}
                            Fotografies i moments destacats de la missió del dia {{ selectedReport.startedAt|date('d/m/Y') }} a {{ selectedReport.worldDisplayName|default(selectedReport.world) }}.
                        {% elseif selectedCampaign and selectedCampaign.description %}
                            {{ selectedCampaign.description }}
                        {% else %}
                            Exploreu les fotografies, captures tàctiques i moments destacats de les nostres operacions militars.
                        {% endif %}
                    </p>
                </div>
                {% if selectedReport %}
                    <a href="{{ path('cc_composite_field_reports_show', { code: selectedReport.code }) }}" class="btn-secondary">
                        <i class="ph ph-file-text"></i> Veure informe de combat
                    </a>
                {% elseif selectedCampaign %}
                    <a href="{{ path('cc_composite_field_reports_campaign', { slug: selectedCampaign.slug }) }}" class="btn-secondary">
                        <i class="ph ph-flag-banner"></i> Veure missions de la campanya
                    </a>
                {% endif %}
            </div>
        </div>
    </div>

    {# Campaign Pills Tabs #}
    <div class="cc-gallery-tabs">
        <a href="{{ path('cc_composite_galeria') }}" class="cc-gallery-tab {% if not selectedCampaign %}active{% endif %}">
            <i class="ph ph-squares-four"></i> Totes les campanyes
        </a>
        {% for c in campaigns %}
            <a href="{{ path('cc_composite_galeria', { campaign: c.slug }) }}" class="cc-gallery-tab {% if selectedCampaign and selectedCampaign.id == c.id %}active{% endif %}">
                <i class="ph ph-flag"></i> {{ c.name }}
            </a>
        {% endfor %}
    </div>

    {# Mission Sub-filter if Campaign Selected #}
    {% if selectedCampaign and campaignMissions is not empty %}
        <div class="cc-mission-tabs">
            <span class="text-xs font-semibold text-secondary flex items-center mr-2">
                <i class="ph ph-funnel mr-1"></i> Filtrar per missió:
            </span>
            <a href="{{ path('cc_composite_galeria', { campaign: selectedCampaign.slug }) }}" class="cc-mission-tab {% if not selectedReport %}active{% endif %}">
                Totes les missions
            </a>
            {% for m in campaignMissions %}
                <a href="{{ path('cc_composite_galeria', { campaign: selectedCampaign.slug, mission: m.code }) }}" class="cc-mission-tab {% if selectedReport and selectedReport.id == m.id %}active{% endif %}">
                    <i class="ph ph-crosshair"></i> {{ m.missionName }} ({{ m.startedAt|date('d/m/Y') }})
                </a>
            {% endfor %}
        </div>
    {% endif %}

    {# Images Grid #}
    {% if images is empty %}
        <div class="card p-8 text-center bg-[#0d1420] border border-line rounded-lg">
            <i class="ph ph-camera-slash text-5xl text-secondary mb-3 inline-block"></i>
            <h3 class="text-xl font-bold mb-2">No s'han trobat fotografies</h3>
            <p class="text-secondary mb-0">Encara no s'ha publicat cap fotografia per a aquesta selecció.</p>
        </div>
    {% else %}
        <div class="cc-gallery-grid" id="galleryGrid">
            {% for idx, img in images %}
                <div class="cc-gallery-card" onclick="openGalleryModal({{ idx }})">
                    <div class="cc-gallery-card__media">
                        <img class="cc-gallery-card__img" src="{{ asset(img.imagePath, 'cc_composite.asset') }}" alt="{{ img.title|default('Fotografia') }}" loading="lazy">
                        <div class="cc-gallery-card__overlay"></div>
                        <div class="cc-gallery-card__media-bottom">
                            <div class="cc-gallery-card__media-left">
                                {% if img.fieldReport %}
                                    <span class="cc-gallery-pill cc-gallery-pill--mission" title="{{ img.fieldReport.missionName }}">
                                        <i class="ph ph-crosshair"></i> {{ img.fieldReport.missionName }}
                                    </span>
                                {% elseif img.effectiveCampaign %}
                                    <span class="cc-gallery-pill cc-gallery-pill--campaign" title="{{ img.effectiveCampaign.name }}">
                                        <i class="ph ph-flag"></i> {{ img.effectiveCampaign.name }}
                                    </span>
                                {% endif %}
                            </div>
                            <div class="cc-gallery-card__media-right">
                                <span class="cc-gallery-pill cc-gallery-pill--date">
                                    <i class="ph ph-calendar-blank"></i> {{ img.createdAt|date('d/m/Y') }}
                                </span>
                            </div>
                        </div>
                    </div>
                    <div class="cc-gallery-card__body">
                        <h4 class="cc-gallery-card__title">{{ img.title|default('Fotografia sense títol') }}</h4>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}
</div>

<!-- Lightbox Modal -->
<div id="ccLightbox" class="cc-lightbox" onclick="handleLightboxBackdropClick(event)">
    <button class="cc-lightbox__close" onclick="closeGalleryModal()" aria-label="Tancar">
        <i class="ph ph-x"></i>
    </button>
    <button class="cc-lightbox__arrow cc-lightbox__arrow--prev" onclick="prevGalleryImage(event)" aria-label="Anterior">
        <i class="ph ph-caret-left"></i>
    </button>
    <button class="cc-lightbox__arrow cc-lightbox__arrow--next" onclick="nextGalleryImage(event)" aria-label="Següent">
        <i class="ph ph-caret-right"></i>
    </button>

    <div class="cc-lightbox__container" onclick="event.stopPropagation()">
        <img id="lightboxImage" class="cc-lightbox__img" src="" alt="">
        <div class="cc-lightbox__info">
            <div id="lightboxTitle" class="cc-lightbox__title"></div>
            <div id="lightboxSub" class="cc-lightbox__sub"></div>
        </div>
    </div>
</div>

<script>
    const galleryItems = [
        {% for img in images %}
            {
                src: "{{ asset(img.imagePath, 'cc_composite.asset') }}",
                title: "{{ (img.title|default('Fotografia'))|escape('js') }}",
                date: "{{ img.createdAt|date('d/m/Y') }}",
                mission: "{{ img.fieldReport ? img.fieldReport.missionName|escape('js') : '' }}",
                missionUrl: "{{ img.fieldReport ? path('cc_composite_field_reports_show', { code: img.fieldReport.code }) : '' }}",
                campaign: "{{ img.effectiveCampaign ? img.effectiveCampaign.name|escape('js') : '' }}"
            }{% if not loop.last %},{% endif %}
        {% endfor %}
    ];

    let currentImageIndex = 0;

    function openGalleryModal(index) {
        if (index < 0 || index >= galleryItems.length) return;
        currentImageIndex = index;
        updateModalContent();
        const modal = document.getElementById('ccLightbox');
        modal.classList.add('active');
        document.body.style.overflow = 'hidden';
    }

    function closeGalleryModal() {
        const modal = document.getElementById('ccLightbox');
        modal.classList.remove('active');
        document.body.style.overflow = '';
    }

    function prevGalleryImage(e) {
        if (e) e.stopPropagation();
        if (galleryItems.length === 0) return;
        currentImageIndex = (currentImageIndex - 1 + galleryItems.length) % galleryItems.length;
        updateModalContent();
    }

    function nextGalleryImage(e) {
        if (e) e.stopPropagation();
        if (galleryItems.length === 0) return;
        currentImageIndex = (currentImageIndex + 1) % galleryItems.length;
        updateModalContent();
    }

    function updateModalContent() {
        const item = galleryItems[currentImageIndex];
        if (!item) return;

        document.getElementById('lightboxImage').src = item.src;
        document.getElementById('lightboxTitle').innerText = item.title;

        let subText = item.date;
        if (item.mission) {
            subText += ' • Missió: ' + item.mission;
        } else if (item.campaign) {
            subText += ' • Campanya: ' + item.campaign;
        }
        document.getElementById('lightboxSub').innerText = subText;
    }

    function handleLightboxBackdropClick(e) {
        if (e.target.id === 'ccLightbox') {
            closeGalleryModal();
        }
    }

    document.addEventListener('keydown', function(e) {
        const modal = document.getElementById('ccLightbox');
        if (!modal || !modal.classList.contains('active')) return;

        if (e.key === 'Escape') {
            closeGalleryModal();
        } else if (e.key === 'ArrowLeft') {
            prevGalleryImage();
        } else if (e.key === 'ArrowRight') {
            nextGalleryImage();
        }
    });
</script>
{% endblock %}
