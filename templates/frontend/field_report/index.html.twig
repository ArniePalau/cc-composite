{% extends '@Forumify/frontend/base.html.twig' %}

{% block title_page %}Informes de camp{% endblock %}

{% block body %}
<style>
.cc-reports{--cc-gold:#e5ac00;--cc-line:rgba(229,172,0,.24);--cc-panel:rgba(10,14,23,.88);max-width:1200px;margin:2rem auto;padding:0 1rem}
.cc-reports__head{margin-bottom:1.5rem}.cc-reports__eyebrow{color:var(--cc-gold);font-family:var(--cdc-font-display,'Oswald'),'Barlow Condensed',Impact,sans-serif;font-size:.75rem;font-weight:700;letter-spacing:.18em;text-transform:uppercase}
.cc-reports h1,.cc-campaigns h2{font-family:var(--cdc-font-display,'Oswald'),'Barlow Condensed',Impact,sans-serif}.cc-reports h1{font-size:clamp(2rem,5vw,3.5rem);line-height:1;margin:.35rem 0}.cc-reports__intro{color:var(--c-text-secondary,#a0a8b0);max-width:720px}
.cc-report-list{display:grid;gap:1rem}.cc-report-card{position:relative;isolation:isolate;display:grid;grid-template-columns:150px 1fr auto;gap:1.25rem;align-items:center;min-height:112px;padding:1.25rem;border:1px solid var(--cc-line);border-radius:12px;background:var(--cc-panel);overflow:hidden;transition:border-color .2s,transform .2s}.cc-report-card>*{position:relative;z-index:2}.cc-report-card--image:after{content:"";position:absolute;z-index:0;inset:0 0 0 42%;background-image:linear-gradient(90deg,var(--cc-panel) 0%,rgba(10,14,23,.72) 34%,rgba(10,14,23,.2) 100%),var(--cc-report-image);background-position:center;background-size:cover;pointer-events:none}.cc-report-card--image:before{content:"";position:absolute;z-index:1;inset:0;background:linear-gradient(90deg,var(--cc-panel) 0%,transparent 72%);pointer-events:none}
.cc-report-card:hover{border-color:var(--cc-gold);transform:translateY(-2px)}.cc-report-card__date{font-weight:700;color:var(--cc-gold)}.cc-report-card__date small{display:block;color:var(--c-text-secondary,#a0a8b0);font-weight:400}
.cc-report-card h2{font-size:1.25rem;margin:0 0 .4rem}.cc-report-card h2 a:hover{color:var(--cc-gold)}.cc-report-card__meta{display:flex;align-items:center;gap:1rem;flex-wrap:wrap;color:var(--c-text-secondary,#a0a8b0);font-size:.9rem}.cc-report-card__campaign{display:inline-flex;align-items:center;gap:.3rem;padding:.2rem .55rem;border:1px solid var(--cc-line);border-radius:999px;color:var(--cc-gold);font-weight:700}.cc-report-card__campaign:hover{border-color:var(--cc-gold);background:rgba(229,172,0,.08)}.cc-report-card__arrow{font-size:1.5rem;color:var(--cc-gold)}
.cc-pagination{display:flex;justify-content:center;align-items:center;gap:.4rem;margin-top:1.5rem}.cc-pagination a,.cc-pagination span{display:grid;place-items:center;min-width:38px;height:38px;border:1px solid var(--cc-line);border-radius:8px}.cc-pagination a:hover,.cc-pagination .active{background:var(--cc-gold);color:#05080f;border-color:var(--cc-gold)}
.cc-empty{padding:3rem;text-align:center;border:1px dashed var(--cc-line);border-radius:12px;color:var(--c-text-secondary,#a0a8b0)}
.cc-campaigns{margin-top:3rem}.cc-campaigns h2{font-size:1.7rem;margin:0 0 1rem}.cc-campaign-list{display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:1rem}.cc-campaign-card{position:relative;display:flex;align-items:flex-end;min-height:190px;padding:1.5rem;border:1px solid var(--cc-line);border-radius:12px;background-color:var(--cc-panel);background-position:center;background-size:cover;overflow:hidden;transition:border-color .2s,box-shadow .2s,transform .2s}.cc-campaign-card--image{border:0}.cc-campaign-card:before{content:"";position:absolute;inset:0;background:linear-gradient(90deg,rgba(5,8,15,.96) 0%,rgba(5,8,15,.78) 48%,rgba(5,8,15,.3) 100%)}.cc-campaign-card:hover{border-color:var(--cc-gold);transform:translateY(-2px)}.cc-campaign-card--image:hover{box-shadow:inset 0 0 0 1px var(--cc-gold)}.cc-campaign-card__content{position:relative;z-index:1;max-width:75%}.cc-campaign-card h3{margin:0 0 .45rem;font-size:1.35rem}.cc-campaign-card p{margin:.35rem 0;color:#d1d5db}.cc-campaign-card__count{color:var(--cc-gold);font-weight:700;font-size:.85rem}
@media(max-width:700px){.cc-report-card{grid-template-columns:1fr auto}.cc-report-card__date{grid-column:1/-1}.cc-report-card__meta{gap:.5rem}}
</style>
<section class="cc-reports">
    <header class="cc-reports__head">
        <div class="cc-reports__eyebrow">Arxiu operacional</div>
        <h1>Informes de camp</h1>
        <p class="cc-reports__intro">Resultats, participants i cronologia de les missions de Cavallers del Cel.</p>
    </header>

    <div class="cc-report-list">
        {% for report in reports %}
            <article class="cc-report-card{% if report.campaign and report.campaign.imagePath %} cc-report-card--image{% endif %}"{% if report.campaign and report.campaign.imagePath %} style="--cc-report-image:url('{{ asset(report.campaign.imagePath, 'cc_composite.asset')|e('html_attr') }}')"{% endif %}>
                <div class="cc-report-card__date">{{ report.startedAt|date('d M Y') }}<small>{{ report.startedAt|date('H:i') }}</small></div>
                <div>
                    <h2><a href="{{ path('cc_composite_field_reports_show', {code: report.code}) }}">{{ report.missionName|replace({'_':' '}) }}</a></h2>
                    <div class="cc-report-card__meta">
                        <span><i class="ph ph-map-trifold"></i> {{ report.worldDisplayName|default(report.world) }}</span>
                        <span><i class="ph ph-clock"></i> {{ report.durationLabel }}</span>
                        <span><i class="ph ph-users"></i> {{ report.playerCount }} participants</span>
                        {% if report.campaign %}<a class="cc-report-card__campaign" href="{{ path('cc_composite_field_reports_campaign', {slug: report.campaign.slug}) }}"><i class="ph ph-flag-banner"></i> {{ report.campaign.name }}</a>{% endif %}
                    </div>
                </div>
                <a class="cc-report-card__arrow" href="{{ path('cc_composite_field_reports_show', {code: report.code}) }}" aria-label="Obre {{ report.missionName|replace({'_':' '}) }}"><i class="ph ph-arrow-right"></i></a>
            </article>
        {% else %}
            <div class="cc-empty">Encara no hi ha informes de camp publicats.</div>
        {% endfor %}
    </div>

    {% if lastPage > 1 %}
        <nav class="cc-pagination" aria-label="Paginació d'informes">
            {% if page > 1 %}<a href="{{ path('cc_composite_field_reports_index', {page: page - 1}) }}" aria-label="Pàgina anterior"><i class="ph ph-caret-left"></i></a>{% endif %}
            {% set firstVisible = max(1, page - 2) %}
            {% set lastVisible = min(lastPage, page + 2) %}
            {% if firstVisible > 1 %}<a href="{{ path('cc_composite_field_reports_index', {page: 1}) }}">1</a>{% if firstVisible > 2 %}<span>…</span>{% endif %}{% endif %}
            {% for pageNumber in firstVisible..lastVisible %}
                {% if pageNumber == page %}<span class="active" aria-current="page">{{ pageNumber }}</span>{% else %}<a href="{{ path('cc_composite_field_reports_index', {page: pageNumber}) }}">{{ pageNumber }}</a>{% endif %}
            {% endfor %}
            {% if lastVisible < lastPage %}{% if lastVisible < lastPage - 1 %}<span>…</span>{% endif %}<a href="{{ path('cc_composite_field_reports_index', {page: lastPage}) }}">{{ lastPage }}</a>{% endif %}
            {% if page < lastPage %}<a href="{{ path('cc_composite_field_reports_index', {page: page + 1}) }}" aria-label="Pàgina següent"><i class="ph ph-caret-right"></i></a>{% endif %}
        </nav>
    {% endif %}

    <section class="cc-campaigns">
        <div class="cc-reports__eyebrow">Operacions agrupades</div>
        <h2>Campanyes</h2>
        <div class="cc-campaign-list">
            {% for campaign in campaigns %}<a class="cc-campaign-card{% if campaign.imagePath %} cc-campaign-card--image{% endif %}" href="{{ path('cc_composite_field_reports_campaign', {slug: campaign.slug}) }}"{% if campaign.imagePath %} style="background-image:url('{{ asset(campaign.imagePath, 'cc_composite.asset')|e('html_attr') }}')"{% endif %}><div class="cc-campaign-card__content"><h3><i class="ph ph-flag-banner"></i> {{ campaign.name }}</h3>{% if campaign.description %}<p>{{ campaign.description }}</p>{% endif %}<span class="cc-campaign-card__count">{{ campaign.reports|length }} missions</span></div></a>
            {% else %}<div class="cc-empty">Encara no hi ha campanyes publicades.</div>{% endfor %}
        </div>
    </section>
</section>
{% endblock %}
