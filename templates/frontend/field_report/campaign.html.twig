{% extends '@Forumify/frontend/base.html.twig' %}
{% block title_page %}{{ campaign.name }}{% endblock %}
{% block body %}
<style>
.cc-campaign{--cc-gold:#e5ac00;--cc-line:rgba(229,172,0,.24);--cc-panel:rgba(10,14,23,.88);max-width:1200px;margin:2rem auto;padding:0 1rem}.cc-campaign__back{color:var(--cc-gold)}.cc-campaign__hero{position:relative;margin:1.5rem 0;padding:0;overflow:hidden;border-radius:14px}.cc-campaign__hero--image{min-height:300px;display:flex;align-items:flex-end;padding:clamp(1.5rem,4vw,3rem);background-image:var(--cc-campaign-image);background-position:center;background-size:cover}.cc-campaign__hero--image:before{content:"";position:absolute;inset:0;background:linear-gradient(90deg,rgba(5,8,15,.97) 0%,rgba(5,8,15,.76) 48%,rgba(5,8,15,.2) 100%)}.cc-campaign__hero-content{position:relative;z-index:1}.cc-campaign h1{font-size:clamp(2rem,5vw,3.5rem);margin:.35rem 0}.cc-campaign header p{color:var(--c-text-secondary,#a0a8b0)}.cc-campaign__hero--image p{color:#d1d5db}.cc-campaign__list{display:grid;gap:1rem}.cc-campaign__report{display:grid;grid-template-columns:150px 1fr auto;align-items:center;gap:1rem;padding:1.2rem;border:1px solid var(--cc-line);border-radius:12px;background:var(--cc-panel)}.cc-campaign__report:hover{border-color:var(--cc-gold)}.cc-campaign__date{color:var(--cc-gold);font-weight:700}.cc-campaign__meta{color:var(--c-text-secondary,#a0a8b0);display:flex;gap:1rem;flex-wrap:wrap}.cc-campaign__empty{padding:2rem;border:1px dashed var(--cc-line);border-radius:12px;text-align:center}@media(max-width:700px){.cc-campaign__hero--image{min-height:230px}.cc-campaign__report{grid-template-columns:1fr auto}.cc-campaign__date{grid-column:1/-1}}
</style>
<section class="cc-campaign"><a class="cc-campaign__back" href="{{ path('cc_composite_field_reports_index') }}"><i class="ph ph-arrow-left"></i> Tots els informes</a><header class="cc-campaign__hero{% if campaign.imagePath %} cc-campaign__hero--image{% endif %}"{% if campaign.imagePath %} style="--cc-campaign-image:url('{{ asset(campaign.imagePath, 'cc_composite.asset')|e('html_attr') }}')"{% endif %}><div class="cc-campaign__hero-content"><div class="cc-campaign__back">Campanya</div><h1>{{ campaign.name }}</h1>{% if campaign.description %}<p>{{ campaign.description }}</p>{% endif %}</div></header><div class="cc-campaign__list">{% for report in reports %}<a class="cc-campaign__report" href="{{ path('cc_composite_field_reports_show', {code: report.code}) }}"><div class="cc-campaign__date">{{ report.startedAt|date('d M Y') }}</div><div><h2>{{ report.missionName|replace({'_':' '}) }}</h2><div class="cc-campaign__meta"><span>{{ report.worldDisplayName|default(report.world) }}</span><span>{{ report.durationLabel }}</span><span>{{ report.playerCount }} participants</span></div></div><i class="ph ph-arrow-right"></i></a>{% else %}<div class="cc-campaign__empty">Aquesta campanya encara no té missions assignades.</div>{% endfor %}</div></section>
{% endblock %}
