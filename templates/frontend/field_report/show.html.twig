{% extends '@Forumify/frontend/base.html.twig' %}

{% macro player(name, playerProfiles, strong = false) %}{% set profile = playerProfiles[name]|default(null) %}{% if profile %}{% if profile.id %}<a class="cc-player-link" href="{{ path('perscom_user', {id: profile.id}) }}" title="Obre el perfil del roster">{% else %}<span class="cc-player-link">{% endif %}{% include '@Forumify/components/avatar.html.twig' with {user: profile.user, className: 'avatar-xs cc-player-avatar'} only %}<span>{% if strong %}<strong>{{ name }}</strong>{% else %}{{ name }}{% endif %}</span>{% if profile.id %}</a>{% else %}</span>{% endif %}{% elseif strong %}<strong>{{ name }}</strong>{% else %}{{ name }}{% endif %}{% endmacro %}
{% macro rankingValue(key, value) %}{% if key in ['kills', 'friendly_fire'] %}{{ value|round }}{% elseif key == 'accuracy' %}{{ (value * 100)|number_format(1) }}%{% elseif key in ['distance', 'distance_vehicle', 'longest_kill'] %}{{ value|round }} m{% elseif key == 'survival' %}{{ (value / 60)|round(0, 'floor') }} min {{ value % 60|round }} s{% elseif key == 'kd' %}{{ value|number_format(2) }}:1{% elseif key == 'damage' %}{{ value|number_format(0) }} pts{% else %}{{ value|number_format(2) }}{% endif %}{% endmacro %}
{% macro missionTime(seconds) %}{{ '%02d:%02d:%02d'|format((seconds / 3600)|round(0, 'floor'), ((seconds % 3600) / 60)|round(0, 'floor'), seconds % 60) }}{% endmacro %}
{% import _self as reportUi %}

{% block title_page %}{{ report.missionName|replace({'_':' '}) }}{% endblock %}

{% block body %}
<link rel="stylesheet" href="https://atlas.plan-ops.fr/lib/leaflet/leaflet.css">
<style>
.cc-field{--cc-gold:#e5ac00;--cc-blue:#3f8ce8;--cc-red:#e8434b;--cc-green:#3fae6b;--cc-line:rgba(229,172,0,.22);--cc-panel:rgba(10,14,23,.9);max-width:1400px;margin:2rem auto;padding:0 1rem;color:var(--c-text-primary,#ececec)}
.cc-field a{color:inherit}.cc-field .cc-player-link{display:inline-flex;align-items:center;gap:.4rem;color:inherit;text-decoration:none}.cc-field .cc-player-link:hover{color:var(--cc-gold)}.cc-player-avatar{width:1.65rem!important;height:1.65rem!important;flex:0 0 1.65rem;border-radius:50%;object-fit:cover;background:#111827}.cc-field__back{display:inline-flex;align-items:center;gap:.4rem;color:var(--cc-gold);margin-bottom:1rem}.cc-field__hero{padding:clamp(1.5rem,4vw,3rem);border:1px solid var(--cc-line);border-radius:16px;background:linear-gradient(135deg,rgba(30,58,138,.35),var(--cc-panel) 60%);position:relative;overflow:hidden}.cc-field__hero>*:not(.cc-field__hero-art){position:relative;z-index:2}.cc-field__hero-art{position:absolute;z-index:0;inset:0 0 0 38%;width:62%;height:100%;object-fit:cover;object-position:center;opacity:.48;pointer-events:none;-webkit-mask-image:linear-gradient(to right,transparent 0,#000 48%,#000 100%);mask-image:linear-gradient(to right,transparent 0,#000 48%,#000 100%)}
.cc-field__hero:before{content:"";position:absolute;z-index:1;inset:0;background:linear-gradient(90deg,rgba(8,13,24,.12) 0,rgba(8,13,24,.18) 52%,rgba(8,13,24,.32) 100%);pointer-events:none}.cc-field__hero:after{content:"";position:absolute;z-index:1;inset:0;background:repeating-linear-gradient(135deg,transparent 0 28px,rgba(255,255,255,.018) 28px 29px);pointer-events:none}.cc-field__eyebrow{color:var(--cc-gold);font-size:.75rem;font-weight:700;letter-spacing:.2em;text-transform:uppercase}.cc-field h1{font-size:clamp(2rem,5vw,4rem);line-height:1;margin:.4rem 0 .55rem}.cc-field__subtitle{margin:0 0 1rem;color:#a9c9ef;font-size:1.05rem}.cc-field__meta{display:flex;gap:1.25rem;flex-wrap:wrap;color:#cbd5e1}
.cc-field__stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:.75rem;margin:1rem 0}.cc-stat{display:flex;align-items:center;gap:.8rem;padding:1rem;border:1px solid var(--cc-line);border-radius:10px;background:var(--cc-panel)}.cc-stat__icon{flex:0 0 auto;color:var(--cc-gold);font-size:1.65rem}.cc-icon{width:1em;height:1em;display:inline-block;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round;vertical-align:-.14em}.cc-stat span{display:block;color:var(--c-text-secondary,#a0a8b0);font-size:.75rem;text-transform:uppercase;letter-spacing:.08em}.cc-stat strong{display:block;font-size:1.6rem;color:#fff;overflow-wrap:anywhere}
.cc-section{margin-top:1rem;border:1px solid var(--cc-line);border-radius:12px;background:var(--cc-panel);overflow:hidden}.cc-section__title{padding:1rem 1.25rem;border-bottom:1px solid var(--cc-line);display:flex;align-items:center;justify-content:space-between;gap:1rem}.cc-section__title h2{font-size:1.2rem;margin:0}.cc-section__body{padding:1.25rem}.cc-muted{color:var(--c-text-secondary,#a0a8b0)}
.cc-kill-chart{padding:1rem 1.25rem}.cc-kill-chart svg{display:block;width:100%;height:150px}.cc-kill-chart__legend{display:flex;gap:1rem;justify-content:flex-end;color:var(--c-text-secondary,#a0a8b0);font-size:.78rem}.cc-kill-chart__legend i{display:inline-block;width:.7rem;height:.7rem;margin-right:.35rem}.cc-tasks{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:.85rem}.cc-task{padding:1.15rem;border:1px solid rgba(125,167,218,.22);border-left:3px solid #64748b;border-radius:10px;background:rgba(30,41,55,.72)}.cc-task--SUCCEEDED{border-left-color:#34d399}.cc-task--ASSIGNED{border-left-color:#37d5e6}.cc-task__head{display:flex;align-items:flex-start;justify-content:space-between;gap:.75rem}.cc-task h3{margin:0;color:#fff;font-size:1rem}.cc-task__state{font-size:.68rem;font-weight:900;letter-spacing:.1em;text-transform:uppercase;color:#8da3bf}.cc-task--SUCCEEDED .cc-task__state{color:#34d399}.cc-task__description{margin:.65rem 0 0;color:#9cb0c9;line-height:1.45}.cc-soldier-groups{display:grid;gap:1.25rem}.cc-soldier-group h3{margin:0 0 .75rem;color:#ff9f1c;font-size:.8rem;letter-spacing:.08em;text-transform:uppercase}.cc-soldier-loadouts{display:grid;grid-template-columns:repeat(auto-fit,minmax(245px,1fr));gap:.8rem}.cc-soldier{padding:1rem;border:1px solid rgba(125,167,218,.22);border-radius:10px;background:rgba(30,41,55,.72)}.cc-soldier__head{display:flex;align-items:center;gap:.7rem;padding-bottom:.75rem;border-bottom:1px solid rgba(255,255,255,.08)}.cc-soldier__head>img{width:2.8rem!important;height:2.8rem!important;border-radius:8px;object-fit:cover}.cc-soldier__name{font-weight:800;color:#fff}.cc-soldier__role{font-size:.78rem;color:#9cb0c9}.cc-soldier__gear{display:grid;grid-template-columns:repeat(4,1fr);gap:.5rem;margin-top:.8rem}.cc-soldier__item{display:flex;align-items:center;justify-content:center;height:48px;padding:.25rem;border-radius:7px;background:rgba(5,8,15,.55)}.cc-soldier__item img{display:block!important;max-width:100%!important;max-height:100%!important;width:auto!important;height:auto!important;object-fit:contain!important}.cc-arma-marker{display:flex;align-items:center;gap:3px;white-space:nowrap;transform:translate(-50%,-50%);pointer-events:none}.cc-arma-marker img{display:block;width:24px;height:24px;object-fit:contain;filter:drop-shadow(0 1px 1px #000)}.cc-arma-marker span{color:#fff;font-size:12px;font-weight:800;text-shadow:-1px -1px 0 #000,1px -1px 0 #000,-1px 1px 0 #000,1px 1px 0 #000}
.cc-map{position:relative;width:min(100%,760px);height:min(760px,calc(100vw - 4rem));min-height:360px;margin:auto;background:#05080f;overflow:hidden;border-radius:8px}.cc-map .leaflet-control-attribution{font-size:10px}.cc-map .leaflet-control-container a{color:#1d4ed8}.cc-map__data{display:none}.cc-map__legend{display:flex;gap:1rem;flex-wrap:wrap;font-size:.8rem;color:var(--c-text-secondary,#a0a8b0)}.cc-dot{display:inline-block;width:9px;height:9px;border-radius:50%;margin-right:.3rem}.cc-map__timeline{display:grid;grid-template-columns:auto minmax(120px,1fr) auto;align-items:center;gap:.85rem;margin-top:1rem}.cc-map__timeline label{font-weight:700}.cc-map__timeline input{width:100%;accent-color:var(--cc-gold)}.cc-map__timeline output{min-width:74px;text-align:right;font-variant-numeric:tabular-nums;color:var(--cc-gold)}
.cc-map--legacy{aspect-ratio:1/1;height:auto;min-height:0;cursor:grab;touch-action:none;user-select:none}.cc-map--legacy.is-dragging{cursor:grabbing}.cc-map__stage{position:absolute;inset:0;transform-origin:center;will-change:transform}.cc-map__stage>img{width:100%;height:100%;object-fit:contain;display:block}.cc-map__overlay{position:absolute;inset:0}.cc-map__point{position:absolute;border-radius:50%;transform:translate(-50%,-50%);pointer-events:none}.cc-map a.cc-map__point{pointer-events:auto;cursor:pointer}.cc-map__movement{background:rgba(63,140,232,.38);border:1px solid rgba(111,174,255,.8)}.cc-map__death{width:14px;height:14px;background:rgba(232,67,75,.72);border:2px solid #ffd0d2}.cc-map__kill{width:9px;height:9px;background:#e5ac00;border:1px solid #fff}.cc-map__marker{width:12px;height:12px;background:#fff;border:2px solid #1e3a8a;transform:translate(-50%,-50%) rotate(45deg)}.cc-map__controls{position:absolute;z-index:3;top:.75rem;right:.75rem;display:grid;gap:.35rem}.cc-map__controls button{display:grid;place-items:center;width:38px;height:38px;border:1px solid rgba(255,255,255,.18);border-radius:7px;background:rgba(5,8,15,.9);color:#fff;cursor:pointer}.cc-map__controls button:hover{color:var(--cc-gold);border-color:var(--cc-gold)}
.cc-grid-2{display:grid;grid-template-columns:1fr 1fr;gap:1rem}.cc-table-wrap{overflow-x:auto}.cc-table{width:100%;border-collapse:collapse}.cc-table th,.cc-table td{padding:.75rem;text-align:left;border-bottom:1px solid rgba(255,255,255,.08);white-space:nowrap}.cc-table th{font-size:.72rem;text-transform:uppercase;letter-spacing:.08em;color:var(--c-text-secondary,#a0a8b0)}.cc-table tbody tr:hover{background:rgba(255,255,255,.025)}
.cc-mvp{display:grid;grid-template-columns:minmax(260px,1.2fr) minmax(420px,1fr);gap:2rem;align-items:center;margin:1rem 0;padding:1.5rem 1.75rem;border:1px solid rgba(229,172,0,.42);border-radius:12px;background:linear-gradient(110deg,rgba(229,172,0,.13),rgba(30,41,59,.82) 48%,var(--cc-panel));overflow:hidden}.cc-mvp__eyebrow{display:flex;align-items:center;gap:.55rem;margin-bottom:.75rem;color:#ffc400;font-size:.78rem;font-weight:900;letter-spacing:.22em;text-transform:uppercase}.cc-mvp__name{font-size:clamp(2rem,4vw,3.2rem);font-weight:900;line-height:1.05;color:#fff}.cc-mvp__name .cc-player-link{gap:.75rem}.cc-mvp__name .cc-player-avatar{width:3.25rem!important;height:3.25rem!important;flex-basis:3.25rem}.cc-mvp__meta{margin-top:.7rem;color:#a9c9ef}.cc-mvp__metrics{display:grid;grid-template-columns:repeat(3,minmax(90px,1fr));gap:1rem}.cc-mvp__metric{padding-left:.8rem;border-left:2px solid rgba(125,167,218,.42)}.cc-mvp__metric span{display:block;color:#86a7d0;font-size:.7rem;font-weight:800;letter-spacing:.14em;text-transform:uppercase}.cc-mvp__metric strong{display:block;margin-top:.25rem;color:#fff;font-size:1.35rem;line-height:1.1}
.cc-logistics{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.25fr);gap:1rem;align-items:start}.cc-frago{display:flex;flex-direction:column;box-sizing:border-box;min-height:0;padding:1.4rem}.cc-frago__eyebrow,.cc-loadout__eyebrow{color:#ff9f1c;font-size:.72rem;font-weight:900;letter-spacing:.16em;text-transform:uppercase}.cc-frago h2{flex:0 0 auto;margin:.65rem 0 .8rem;font-size:1.2rem}.cc-frago__body{flex:1 1 auto;min-height:0;margin:0;padding-right:.6rem;color:#b7cee9;line-height:1.55;white-space:normal;overflow-y:auto;overscroll-behavior:contain;scrollbar-color:var(--cc-gold) rgba(255,255,255,.05);scrollbar-width:thin}.cc-frago__formatted{display:inline}.cc-frago__marker{color:var(--cc-gold);font-weight:700}.cc-loadout{display:grid;gap:1rem}.cc-loadout__group{padding:1.25rem}.cc-loadout__heading{display:flex;align-items:center;gap:.8rem;margin-bottom:1rem}.cc-loadout__heading:after{content:"";height:1px;flex:1;background:rgba(125,167,218,.25)}.cc-media-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,300px));justify-content:start;gap:.85rem}.cc-media-card{display:grid;grid-template-rows:145px auto;width:100%;max-width:300px;height:100%;border:1px solid rgba(125,167,218,.2);border-radius:10px;background:rgba(30,41,55,.72);overflow:hidden}.cc-media-card__image{display:flex;align-items:center;justify-content:center;box-sizing:border-box;margin:.8rem .8rem 0;padding:.65rem;border-radius:7px;background:rgba(255,255,255,.035);overflow:hidden}.cc-media-card__image img{display:block!important;box-sizing:border-box!important;width:auto!important;height:auto!important;max-width:100%!important;max-height:100%!important;object-fit:contain!important;object-position:center!important;margin:0!important;padding:0!important}.cc-media-card__content{padding:1rem}.cc-media-card h3{margin:0;font-size:1rem;color:#fff}.cc-media-card__class{display:block;margin-top:.15rem;color:#7694bd;font-size:.72rem;overflow-wrap:anywhere}.cc-media-card__stats{display:flex;gap:1.5rem;margin-top:.9rem}.cc-media-card__stats strong{display:block;color:#fff;font-size:1.2rem}.cc-media-card__stats span{display:block;color:#9cb8da;font-size:.78rem}.cc-media-card__empty{color:var(--c-text-secondary,#a0a8b0)}
.cc-mission-gallery{box-sizing:border-box;padding:1.25rem!important}.cc-mission-gallery__header{display:flex;align-items:center;justify-content:space-between;gap:1rem;margin-bottom:1.25rem;padding-bottom:1rem;border-bottom:1px solid var(--cc-line)}.cc-mission-gallery__header h2{margin:0}.cc-mission-gallery__header p{margin:.35rem 0 0}.cc-mission-gallery__grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:1.25rem;width:100%}
.cc-feed-filters{display:flex;align-items:center;gap:.75rem;flex-wrap:wrap}.cc-feed-filter{display:inline-flex;align-items:center;gap:.5rem;font-size:.82rem;font-weight:700;cursor:pointer}.cc-feed-filter input{width:1rem;height:1rem;accent-color:var(--cc-gold)}.cc-feed{display:grid;gap:.65rem;max-height:780px;overflow-y:auto;overscroll-behavior:contain;scrollbar-color:var(--cc-gold) rgba(255,255,255,.05);scrollbar-width:thin}.cc-feed__row{display:grid;grid-template-columns:70px minmax(110px,.8fr) minmax(70px,.65fr) minmax(145px,.85fr) minmax(70px,.65fr) minmax(160px,1.1fr);align-items:center;gap:1rem;min-height:68px;padding:1rem 1.25rem;border-left:3px solid var(--cc-blue);background:rgba(255,255,255,.025)}.cc-feed__row[hidden]{display:none}.cc-feed__row--friendly{border-left-color:var(--cc-red)}.cc-feed__time{font-variant-numeric:tabular-nums;color:var(--cc-gold);font-weight:700}.cc-feed__attacker{font-weight:700}.cc-person--player{color:#facc15}.cc-person--enemy{color:#ff5733}.cc-person--civilian{color:#60a5fa}.cc-feed__arrow{position:relative;display:block;align-self:center;width:100%;height:16px;min-width:55px}.cc-feed__arrow:before{content:"";position:absolute;left:0;right:5px;top:50%;border-top:2px solid #f8fafc;transform:translateY(-50%)}.cc-feed__arrow:after{content:"";position:absolute;right:1px;top:50%;width:8px;height:8px;border-top:2px solid #f8fafc;border-right:2px solid #f8fafc;transform:translateY(-50%) rotate(45deg)}.cc-feed__action{display:flex;align-items:center;justify-content:center;gap:.65rem;color:#fff;font-weight:800;font-size:1.05rem}.cc-feed__icon{display:grid;place-items:center;flex:0 0 auto;width:42px;height:42px;border-radius:50%;background:rgba(232,67,75,.12);color:#ef233c;font-size:1.4rem}.cc-feed__row--friendly .cc-feed__icon{background:rgba(232,67,75,.13);color:var(--cc-red)}.cc-feed__icon--suicide{background:rgba(255,255,255,.08);color:#d8dee9}.cc-feed__result{min-width:0}.cc-feed__weapon{display:block;margin-top:.2rem;color:var(--c-text-secondary,#a0a8b0);font-size:.78rem;font-weight:400;white-space:normal}.cc-feed__empty-filter{display:none;padding:1.25rem;text-align:center;color:var(--c-text-secondary,#a0a8b0)}.cc-feed__empty-filter.is-visible{display:block}.cc-ranking{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:.75rem}.cc-ranking__card{padding:1rem;border:1px solid rgba(255,255,255,.08);border-radius:8px}.cc-ranking__card h3{display:flex;align-items:center;gap:.45rem;font-size:.8rem;text-transform:uppercase;color:var(--cc-gold);margin:0 0 .65rem}.cc-ranking__card h3 i{font-size:1.1rem}.cc-ranking__entry{display:flex;align-items:center;justify-content:space-between;gap:.75rem;padding:.3rem 0}.cc-ranking__entry>span{display:flex;align-items:center;gap:.35rem;min-width:0;white-space:nowrap}.cc-ranking__entry>strong{flex:0 0 auto;white-space:nowrap;line-height:1}.cc-ranking__entry .cc-player-link{display:inline-flex;align-items:center;white-space:nowrap}.cc-field__source{display:flex;justify-content:space-between;gap:1rem;flex-wrap:wrap;margin-top:1rem;color:var(--c-text-secondary,#a0a8b0);font-size:.8rem}
@media(max-width:1000px){.cc-feed__row{grid-template-columns:64px minmax(100px,1fr) 60px minmax(130px,1fr);gap:.75rem}.cc-feed__arrow--after{display:none}.cc-feed__result{grid-column:4}.cc-field__stats{grid-template-columns:repeat(2,1fr)}.cc-grid-2,.cc-logistics{grid-template-columns:1fr}.cc-frago{height:auto!important;min-height:0;max-height:650px}.cc-mission-gallery__header{align-items:flex-start;flex-direction:column}}@media(max-width:650px){.cc-field__stats{grid-template-columns:1fr 1fr}.cc-field__hero-art{inset:0 0 0 18%;width:82%;opacity:.32}.cc-feed__row{grid-template-columns:52px 1fr 38px}.cc-feed__arrow{display:none}.cc-feed__action{grid-column:3}.cc-feed__result{grid-column:2/-1}.cc-field__meta{gap:.6rem}.cc-map{min-height:300px}.cc-map__timeline{grid-template-columns:1fr auto}.cc-map__timeline input{grid-column:1/-1;grid-row:2}.cc-media-grid{grid-template-columns:1fr}.cc-mission-gallery{padding:1rem!important}.cc-mission-gallery__grid{grid-template-columns:1fr}}
</style>
<article class="cc-field">
    <svg width="0" height="0" aria-hidden="true" style="position:absolute;overflow:hidden">
        <symbol id="cc-icon-users" viewBox="0 0 24 24"><circle cx="9" cy="8" r="3"/><path d="M3 20c0-4 2.5-6 6-6s6 2 6 6M16 5a3 3 0 0 1 0 6M17 14c2.5.5 4 2.5 4 6"/></symbol>
        <symbol id="cc-icon-target" viewBox="0 0 24 24"><circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="3"/><path d="M12 2v4M12 18v4M2 12h4M18 12h4"/></symbol>
        <symbol id="cc-icon-warning" viewBox="0 0 24 24"><path d="M12 3 2.5 20h19z"/><path d="M12 9v5M12 17.5h.01"/></symbol>
        <symbol id="cc-icon-shots" viewBox="0 0 24 24"><path d="M3 15h10l3-3h3l2 2-2 2h-2l-2 5h-4l1-4H3z"/><path d="M5 12l-2-2M8 10V7M11 11l2-2"/></symbol>
        <symbol id="cc-icon-clock" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></symbol>
        <symbol id="cc-icon-trophy" viewBox="0 0 24 24"><path d="M7 4h10v4c0 4-2 7-5 7s-5-3-5-7zM9 21h6M12 15v6"/><path d="M7 6H3v2c0 3 2 5 5 5M17 6h4v2c0 3-2 5-5 5"/></symbol>
        <symbol id="cc-icon-skull" viewBox="0 0 24 24"><path d="M5 11a7 7 0 1 1 14 0c0 3-1.5 4.5-3 5.5V21H8v-4.5C6.5 15.5 5 14 5 11z"/><circle cx="9" cy="11" r="1"/><circle cx="15" cy="11" r="1"/><path d="M10 16h4M10 21v-3M14 21v-3"/></symbol>
        <symbol id="cc-icon-scales" viewBox="0 0 24 24"><path d="M12 3v18M6 21h12M4 7h16M6 7l-3 6h6zM18 7l-3 6h6z"/></symbol>
        <symbol id="cc-icon-heart" viewBox="0 0 24 24"><path d="M12 21S3 16 3 9a5 5 0 0 1 9-3 5 5 0 0 1 9 3c0 7-9 12-9 12z"/><path d="m8 12 2-2 2 4 2-4 2 2"/></symbol>
        <symbol id="cc-icon-footprints" viewBox="0 0 24 24"><ellipse cx="8" cy="7" rx="3" ry="5"/><ellipse cx="16" cy="17" rx="3" ry="5"/></symbol>
        <symbol id="cc-icon-binoculars" viewBox="0 0 24 24"><path d="M7 6h3l1 5v6H3l2-9zM17 6h-3l-1 5v6h8l-2-9zM11 12h2"/><circle cx="7" cy="17" r="4"/><circle cx="17" cy="17" r="4"/></symbol>
        <symbol id="cc-icon-vehicle" viewBox="0 0 24 24"><path d="M4 15V9l2-4h11l3 5v5M3 15h18v4h-2M5 19H3v-4M8 19h8"/><circle cx="7" cy="17" r="2"/><circle cx="17" cy="17" r="2"/></symbol>
    </svg>
    <a class="cc-field__back" href="{{ path('cc_composite_field_reports_index') }}"><i class="ph ph-arrow-left"></i> Tots els informes</a>

    {% set playerNames = data.players|default([])|map(player => player.name) %}
    {% set playerFriendlyFire = data.killFeed|default([])|filter(kill => kill.friendlyFire|default(false) and (kill.killerIsPlayer|default(false) or kill.killer|default('') in playerNames))|length %}

    <header class="cc-field__hero">
        <img class="cc-field__hero-art" src="{{ path('cc_composite_field_reports_mission_media', {code: report.code}) }}" alt="" aria-hidden="true">
        <div class="cc-field__eyebrow">Informe de missió · {{ report.code }}</div>
        <h1>{{ report.missionName|replace({'_':' '}) }}</h1>
        {% if data.missionTitle|default(null) or data.missionOverview|default(null) %}<p class="cc-field__subtitle">{{ data.missionTitle|default(data.missionOverview) }}{% if data.missionTitle|default(null) and data.missionOverview|default(null) and data.missionOverview != data.missionTitle %} · {{ data.missionOverview }}{% endif %}</p>{% endif %}
        <div class="cc-field__meta">
            <span><i class="ph ph-calendar"></i> {{ report.startedAt|date('d/m/Y · H:i') }}</span>
            <span><i class="ph ph-map-trifold"></i> {{ report.worldDisplayName|default(report.world) }}</span>
            <span><i class="ph ph-clock"></i> {{ report.durationLabel }}</span>
            {% if report.serverName %}<span><i class="ph ph-server"></i> {{ report.serverName }}</span>{% endif %}
            {% if data.missionAuthor|default(null) %}<span><i class="ph ph-pencil"></i> {{ data.missionAuthor }}</span>{% endif %}
        </div>
    </header>

    <div class="cc-field__stats">
        <div class="cc-stat"><svg class="cc-stat__icon cc-icon" aria-hidden="true"><use href="#cc-icon-users"/></svg><div><span>Participants</span><strong>{{ report.playerCount }}</strong></div></div>
        <div class="cc-stat"><svg class="cc-stat__icon cc-icon" aria-hidden="true"><use href="#cc-icon-target"/></svg><div><span>Baixes totals</span><strong>{{ report.totalKills }}</strong></div></div>
        <div class="cc-stat"><svg class="cc-stat__icon cc-icon" aria-hidden="true"><use href="#cc-icon-warning"/></svg><div><span>Foc amic</span><strong>{{ playerFriendlyFire }}</strong></div></div>
        <div class="cc-stat"><svg class="cc-stat__icon cc-icon" aria-hidden="true"><use href="#cc-icon-shots"/></svg><div><span>Trets</span><strong>{{ report.totalShots }}</strong></div></div>
        <div class="cc-stat"><svg class="cc-stat__icon cc-icon" aria-hidden="true"><use href="#cc-icon-clock"/></svg><div><span>Durada</span><strong>{{ report.durationLabel }}</strong></div></div>
        {% if data.totalCivilianKills is defined %}<div class="cc-stat"><svg class="cc-stat__icon cc-icon" aria-hidden="true"><use href="#cc-icon-users"/></svg><div><span>Civils morts</span><strong>{{ data.totalCivilianKills }}</strong></div></div>{% endif %}
        {% if data.totalVehicleKills is defined %}<div class="cc-stat"><svg class="cc-stat__icon cc-icon" aria-hidden="true"><use href="#cc-icon-vehicle"/></svg><div><span>Vehicles destruïts</span><strong>{{ data.totalVehicleKills }}</strong></div></div>{% endif %}
    </div>

    {% set tacticalMap %}
    {% set resolvedMapSize = report.mapSizeMeters|default(data._ccMap.sizeInMeters|default(0)) %}
    {% if data._ccMap is defined and resolvedMapSize > 0 %}
        <section class="cc-section">
            <div class="cc-section__title">
                <h2><i class="ph ph-map-trifold"></i> Mapa tàctic</h2>
                <div class="cc-map__legend">
                    <span><i class="cc-dot" style="background:#3f8ce8"></i>Moviment</span>
                    <span><i class="cc-dot" style="background:#e8434b"></i>Morts</span>
                    <span><i class="cc-dot" style="background:#e5ac00"></i>Baixes</span>
                    <span><i class="cc-dot" style="background:#ffffff"></i>Marques</span>
                </div>
            </div>
            <div class="cc-section__body">
                <div id="cc-field-map-{{ report.id }}" class="cc-map" data-cc-tiled-map data-map-config="{{ data._ccMap|json_encode|e('html_attr') }}" aria-label="Mapa topogràfic interactiu de {{ report.worldDisplayName|default(report.world) }}"></div>
                <div class="cc-map__data" data-map-points>
                        {% for point in data.movementHeat|default([]) %}
                            <i data-map-point data-kind="movement" data-x="{{ point.x }}" data-y="{{ point.y }}" data-weight="{{ point.weight|default(1) }}"></i>
                        {% endfor %}
                        {% for point in data.deathHeat|default([]) %}
                            <i data-map-point data-kind="death" data-x="{{ point.x }}" data-y="{{ point.y }}" data-weight="{{ point.weight|default(1) }}"></i>
                        {% endfor %}
                        {% for kill in data.killFeed|default([]) %}
                            {% if kill.x is defined and kill.y is defined and not kill.suicide %}{% set mapProfile = playerProfiles[kill.killer|default('')]|default(playerProfiles[kill.victim|default('')]|default(null)) %}<i data-map-point data-kind="kill" data-x="{{ kill.x }}" data-y="{{ kill.y }}" data-event-time="{{ kill.missionTime|default(0) }}" data-title="{{ (kill.killer|default('Desconegut') ~ ' → ' ~ kill.victim|default('Desconegut'))|e('html_attr') }}"{% if mapProfile and mapProfile.id %} data-profile-url="{{ path('perscom_user', {id: mapProfile.id}) }}"{% endif %}></i>{% endif %}
                        {% endfor %}
                        {% for marker in data.markers|default([]) %}
                            {% if not marker.deleted|default(false) %}<i data-map-point data-kind="marker" data-x="{{ marker.x }}" data-y="{{ marker.y }}" data-shape="{{ marker.shape|default('ICON')|upper }}" data-color="{{ marker.colorHex|default(marker.color|default(''))|e('html_attr') }}" data-polyline="{{ marker.polyline|default([])|json_encode|e('html_attr') }}" data-size-a="{{ marker.sizeA|default(1) }}" data-size-b="{{ marker.sizeB|default(1) }}" data-direction="{{ marker.direction|default(0) }}" data-alpha="{{ marker.alpha|default(1) }}" data-brush="{{ marker.brush|default('')|e('html_attr') }}" data-marker-type="{{ marker.type|default('')|e('html_attr') }}"{% if marker.type|default('') %} data-marker-icon="{{ path('cc_composite_field_reports_media', {code: report.code, kind: 'marker', assetClass: marker.type}) }}"{% endif %}{% if marker.missionTime is defined %} data-event-time="{{ marker.missionTime }}"{% endif %} data-title="{{ marker.text|default('')|e('html_attr') }}" data-author="{{ marker.author|default('')|e('html_attr') }}"></i>{% endif %}
                        {% endfor %}
                </div>
                <div class="cc-map__timeline">
                    <label for="cc-map-time"><i class="ph ph-timer"></i> Temps de missió</label>
                    <input id="cc-map-time" type="range" min="0" max="{{ report.durationSeconds }}" value="{{ report.durationSeconds }}" step="1" data-map-time>
                    <output for="cc-map-time" data-map-time-label>{{ report.durationLabel }}</output>
                </div>
            </div>
        </section>
    {% elseif report.mapPath and resolvedMapSize > 0 %}
        <section class="cc-section">
            <div class="cc-section__title"><h2><i class="ph ph-map-trifold"></i> Mapa tàctic</h2><div class="cc-map__legend"><span><i class="cc-dot" style="background:#3f8ce8"></i>Moviment</span><span><i class="cc-dot" style="background:#e8434b"></i>Morts</span><span><i class="cc-dot" style="background:#e5ac00"></i>Baixes</span></div></div>
            <div class="cc-section__body">
                <div class="cc-map cc-map--legacy" data-cc-interactive-map>
                    <div class="cc-map__stage" data-map-stage><img src="{{ asset(report.mapPath, 'cc_composite.asset') }}" alt="Mapa topogràfic de {{ report.worldDisplayName|default(report.world) }}"><div class="cc-map__overlay">
                        {% for point in data.movementHeat|default([]) %}<i class="cc-map__point cc-map__movement" style="left:{{ (point.x / resolvedMapSize * 100)|round(3) }}%;top:{{ ((1 - point.y / resolvedMapSize) * 100)|round(3) }}%;width:{{ min(26, 7 + point.weight|default(1)) }}px;height:{{ min(26, 7 + point.weight|default(1)) }}px"></i>{% endfor %}
                        {% for point in data.deathHeat|default([]) %}<i class="cc-map__point cc-map__death" style="left:{{ (point.x / resolvedMapSize * 100)|round(3) }}%;top:{{ ((1 - point.y / resolvedMapSize) * 100)|round(3) }}%"></i>{% endfor %}
                        {% for kill in data.killFeed|default([]) %}{% if kill.x is defined and kill.y is defined and not kill.suicide %}{% set mapProfile = playerProfiles[kill.killer|default('')]|default(playerProfiles[kill.victim|default('')]|default(null)) %}{% if mapProfile and mapProfile.id %}<a href="{{ path('perscom_user', {id: mapProfile.id}) }}" class="cc-map__point cc-map__kill" data-event-time="{{ kill.missionTime|default(0) }}" title="{{ kill.killer|default('Desconegut') }} → {{ kill.victim|default('Desconegut') }}" style="left:{{ (kill.x / resolvedMapSize * 100)|round(3) }}%;top:{{ ((1 - kill.y / resolvedMapSize) * 100)|round(3) }}%"></a>{% else %}<i class="cc-map__point cc-map__kill" data-event-time="{{ kill.missionTime|default(0) }}" title="{{ kill.killer|default('Desconegut') }} → {{ kill.victim|default('Desconegut') }}" style="left:{{ (kill.x / resolvedMapSize * 100)|round(3) }}%;top:{{ ((1 - kill.y / resolvedMapSize) * 100)|round(3) }}%"></i>{% endif %}{% endif %}{% endfor %}
                        {% for marker in data.markers|default([]) %}{% if not marker.deleted|default(false) %}<i class="cc-map__point cc-map__marker"{% if marker.missionTime is defined %} data-event-time="{{ marker.missionTime }}"{% endif %} title="{{ marker.text|default(marker.name|default('Marcador')) }}" style="left:{{ (marker.x / resolvedMapSize * 100)|round(3) }}%;top:{{ ((1 - marker.y / resolvedMapSize) * 100)|round(3) }}%"></i>{% endif %}{% endfor %}
                    </div></div>
                    <div class="cc-map__controls"><button type="button" data-map-zoom="in" title="Apropa"><i class="ph ph-plus"></i></button><button type="button" data-map-zoom="out" title="Allunya"><i class="ph ph-minus"></i></button><button type="button" data-map-zoom="reset" title="Restableix"><i class="ph ph-arrows-in"></i></button></div>
                </div>
                <div class="cc-map__timeline"><label for="cc-map-time-legacy"><i class="ph ph-timer"></i> Temps de missió</label><input id="cc-map-time-legacy" type="range" min="0" max="{{ report.durationSeconds }}" value="{{ report.durationSeconds }}" step="1" data-map-time><output for="cc-map-time-legacy" data-map-time-label>{{ report.durationLabel }}</output></div>
            </div>
        </section>
    {% endif %}
    {% endset %}

    <section class="cc-section">
            <div class="cc-section__title"><h2><i class="ph ph-users"></i> Participants</h2></div>
            <div class="cc-table-wrap">
                <table class="cc-table">
                    <thead><tr><th>Nom</th><th>Baixes</th><th>Morts</th><th>Precisió</th><th>Distància</th><th>A peu</th><th>En vehicle</th><th>Trets</th><th>Punts</th></tr></thead>
                    <tbody>
                    {% for player in data.players|default([]) %}
                        <tr><td>{{ reportUi.player(player.name, playerProfiles, true) }}{% if player.role|default(null) or player.groupName|default(null) %}<small class="cc-muted" style="display:block;margin-top:.25rem">{{ player.role|default('') }}{% if player.role|default(null) and player.groupName|default(null) %} · {% endif %}{{ player.groupName|default('') }}</small>{% endif %}</td><td>{{ player.kills|default(0) }}</td><td>{{ player.deaths|default(0) }}</td><td>{{ ((player.accuracy|default(0)) * 100)|number_format(1) }}%</td><td>{{ player.distanceMeters|default(0) }} m</td><td>{% if player.distanceFootMeters is defined %}{{ player.distanceFootMeters }} m{% else %}—{% endif %}</td><td>{% if player.distanceVehicleMeters is defined %}{{ player.distanceVehicleMeters }} m{% else %}—{% endif %}</td><td>{{ player.shotsFired|default(player.shots|default(0)) }}</td><td>{{ player.mvpPoints|default(0)|number_format(1) }}</td></tr>
                    {% else %}<tr><td colspan="9">No hi ha participants registrats.</td></tr>{% endfor %}
                    </tbody>
                </table>
            </div>
    </section>

    {% if data.killFeed|default([])|length > 2 %}
    <section class="cc-section">
        <div class="cc-section__title"><h2><i class="ph ph-chart-bar"></i> Baixes durant la missió</h2><div class="cc-kill-chart__legend"><span><i style="background:#e53d3d"></i>Baixes enemigues</span><span><i style="background:#3fa0ff"></i>Baixes de jugadors</span></div></div>
        <div class="cc-kill-chart"><svg viewBox="0 0 960 120" preserveAspectRatio="none" role="img" aria-label="Gràfic temporal de baixes">
            {% for count in killTimeline.hostile %}{% if count > 0 %}<rect x="{{ loop.index0 * 20 + 1 }}" y="{{ 96 - (count / killTimeline.max * 88) }}" width="18" height="{{ count / killTimeline.max * 88 }}" fill="#e53d3d" opacity=".88"/>{% endif %}{% endfor %}
            {% for count in killTimeline.player %}{% if count > 0 %}<rect x="{{ loop.index0 * 20 + 1 }}" y="{{ 96 - (count / killTimeline.max * 88) }}" width="18" height="{{ count / killTimeline.max * 88 }}" fill="#3fa0ff" opacity=".92"/>{% endif %}{% endfor %}
            {% for bucket in killTimeline.buckets %}<rect class="cc-kill-chart__hover" x="{{ loop.index0 * 20 }}" y="0" width="20" height="96" fill="transparent"><title>Temps mitjà: {{ reportUi.missionTime(bucket.midpoint) }} · Interval: {{ reportUi.missionTime(bucket.start) }}–{{ reportUi.missionTime(bucket.end) }} · Baixes enemigues: {{ bucket.hostile }} · Baixes de jugadors: {{ bucket.player }}</title></rect>{% endfor %}
            <line x1="0" y1="96" x2="960" y2="96" stroke="rgba(255,255,255,.25)"/><text x="0" y="116" fill="rgba(255,255,255,.5)" font-size="13">00:00</text><text x="960" y="116" text-anchor="end" fill="rgba(255,255,255,.5)" font-size="13">{{ report.durationLabel }}</text>
        </svg></div>
    </section>
    {% endif %}

    <section class="cc-section">
        <div class="cc-section__title"><h2><i class="ph ph-crosshair"></i> Cronologia de baixes</h2><div class="cc-feed-filters"><label class="cc-feed-filter"><input type="checkbox" data-feed-players-only> Només jugadors</label></div></div>
        <div class="cc-section__body cc-feed" data-kill-feed>
            {% for kill in data.killFeed|default([])|reverse %}
                {% set killerIsCivilian = kill.killerIsCivilian|default(false) or kill.killerSide|default('')|upper in ['CIV', 'CIVILIAN'] %}
                {% set victimIsCivilian = kill.victimIsCivilian|default(false) or kill.victimSide|default('')|upper in ['CIV', 'CIVILIAN'] %}
                {% set killerClass = kill.killerIsPlayer|default(false) ? 'cc-person--player' : (killerIsCivilian ? 'cc-person--civilian' : 'cc-person--enemy') %}
                {% set victimClass = kill.victimIsPlayer|default(false) ? 'cc-person--player' : (victimIsCivilian ? 'cc-person--civilian' : 'cc-person--enemy') %}
                {% set playerInvolved = kill.killerIsPlayer|default(false) or kill.victimIsPlayer|default(false) or playerProfiles[kill.killer|default('')] is defined or playerProfiles[kill.victim|default('')] is defined %}
                <div class="cc-feed__row{% if kill.friendlyFire|default(false) %} cc-feed__row--friendly{% endif %}" data-player-involved="{{ playerInvolved ? '1' : '0' }}">
                    <span class="cc-feed__time">{{ '%02d:%02d'|format((kill.missionTime / 60)|round(0, 'floor'), kill.missionTime % 60) }}</span>
                    <span class="cc-feed__attacker {{ killerClass }}">{{ reportUi.player(kill.killer|default('IA / entorn'), playerProfiles, true) }}</span>
                    <span class="cc-feed__arrow" aria-hidden="true"></span>
                    <span class="cc-feed__action">
                        {% if kill.suicide|default(false) %}<span class="cc-feed__icon cc-feed__icon--suicide" title="Suïcidi"><svg class="cc-icon" aria-hidden="true"><use href="#cc-icon-skull"/></svg></span><span>Suïcidi</span>{% elseif kill.friendlyFire|default(false) %}<span class="cc-feed__icon" title="Foc amic"><svg class="cc-icon" aria-hidden="true"><use href="#cc-icon-warning"/></svg></span><span>Foc amic</span>{% else %}<span class="cc-feed__icon" title="Baixa"><svg class="cc-icon" aria-hidden="true"><use href="#cc-icon-target"/></svg></span><span>Kill</span>{% endif %}
                    </span>
                    <span class="cc-feed__arrow cc-feed__arrow--after" aria-hidden="true"{% if kill.suicide|default(false) %} style="visibility:hidden"{% endif %}></span>
                    <span class="cc-feed__result">{% if not kill.suicide|default(false) %}<span class="{{ victimClass }}">{{ reportUi.player(kill.victim|default('Desconegut'), playerProfiles, true) }}</span><small class="cc-feed__weapon">{{ kill.weaponName|default(kill.weaponClass|default('Arma desconeguda')) }}{% if kill.vehicleName|default(null) %} · {{ kill.vehicleName }}{% endif %}{% if kill.distance|default(0) > 0 %} · {{ kill.distance|round }} m{% endif %}</small>{% endif %}</span>
                </div>
            {% else %}<p class="cc-muted">No hi ha baixes registrades.</p>{% endfor %}
            <p class="cc-feed__empty-filter" data-feed-empty>No hi ha esdeveniments amb jugadors.</p>
        </div>
    </section>

    {% if tasks is not empty %}
    <section class="cc-section">
        <div class="cc-section__title"><h2><i class="ph ph-check-square"></i> Tasques ({{ tasks|length }})</h2></div>
        <div class="cc-section__body cc-tasks">
            {% for task in tasks %}<article class="cc-task cc-task--{{ task.state }}"><div class="cc-task__head"><h3>{{ task.title|default('(sense títol)') }}</h3><span class="cc-task__state">{{ task.state == 'SUCCEEDED' ? 'Completada' : (task.state == 'ASSIGNED' ? 'Assignada' : (task.state == 'CREATED' ? 'Creada' : task.state)) }}</span></div>{% if task.descriptionHtml %}<div class="cc-task__description">{{ task.descriptionHtml|raw }}</div>{% endif %}</article>{% endfor %}
        </div>
    </section>
    {% endif %}

    {% if data.players|default([]) is not empty %}
    <section class="cc-section">
        <div class="cc-section__title"><h2><i class="ph ph-person-simple-run"></i> Equipament dels soldats ({{ data.players|length }})</h2></div>
        <div class="cc-section__body cc-soldier-groups">
            {% for groupName, soldiers in playerGroups %}<div class="cc-soldier-group"><h3>{{ groupName }}</h3><div class="cc-soldier-loadouts">
                {% for player in soldiers %}<article class="cc-soldier"><div class="cc-soldier__head">{% set profile = playerProfiles[player.name]|default(null) %}{% if not profile and player.avatarKey|default(null) %}<img src="{{ path('cc_composite_field_reports_media', {code: report.code, kind: 'avatar', assetClass: player.avatarKey}) }}" alt="">{% endif %}<div><div class="cc-soldier__name">{{ reportUi.player(player.name, playerProfiles, false) }}</div><div class="cc-soldier__role">{{ player.role|default('') }}</div></div></div><div class="cc-soldier__gear">{% for item in player.loadout|default([]) %}<span class="cc-soldier__item" title="{{ item.itemName|default(item.itemClass) }}"><img src="{{ path('cc_composite_field_reports_media', {code: report.code, kind: 'item', assetClass: item.itemClass}) }}" alt="{{ item.itemName|default(item.itemClass) }}" loading="lazy"></span>{% endfor %}</div></article>{% endfor %}
            </div></div>{% endfor %}
        </div>
    </section>
    {% endif %}

    {{ tacticalMap|raw }}

    <div class="cc-logistics">
        <section class="cc-section cc-frago" data-frago-panel>
            <div class="cc-frago__eyebrow">FRAGORD</div>
            {% if frago %}
                <h2>{{ frago.title|default('Ordre fragmentària') }}</h2>
                <div class="cc-frago__body">{{ frago.bodyHtml|raw }}</div>
            {% else %}
                <h2>Ordre fragmentària</h2>
                <p class="cc-frago__body cc-muted">Aquest informe no conté cap FRAGO.</p>
            {% endif %}
        </section>

        <div class="cc-loadout" data-loadout-panel>
            <section class="cc-section cc-loadout__group">
                <div class="cc-loadout__heading"><span class="cc-loadout__eyebrow">Armament utilitzat</span></div>
                <div class="cc-media-grid">
                    {% for weapon in data.weapons|default([]) %}
                        <article class="cc-media-card">
                            <div class="cc-media-card__image"><img src="{{ path('cc_composite_field_reports_media', {code: report.code, kind: 'weapon', assetClass: weapon.weaponClass}) }}" alt="{{ weapon.weaponName|default(weapon.weaponClass) }}" loading="lazy"></div>
                            <div class="cc-media-card__content"><h3>{{ weapon.weaponName|default(weapon.weaponClass) }}</h3><span class="cc-media-card__class">{{ weapon.weaponClass }}</span><div class="cc-media-card__stats"><div><strong>{{ weapon.kills|default(0) }}</strong><span>baixes</span></div><div><strong>{{ weapon.shots|default(0) }}</strong><span>trets</span></div></div></div>
                        </article>
                    {% else %}<p class="cc-media-card__empty">No hi ha dades d'armament.</p>{% endfor %}
                </div>
            </section>

            <section class="cc-section cc-loadout__group">
                <div class="cc-loadout__heading"><span class="cc-loadout__eyebrow">Vehicles utilitzats</span></div>
                <div class="cc-media-grid">
                    {% for vehicle in data.vehicles|default([]) %}
                        <article class="cc-media-card">
                            <div class="cc-media-card__image"><img src="{{ path('cc_composite_field_reports_media', {code: report.code, kind: 'vehicle', assetClass: vehicle.vehicleClass}) }}" alt="{{ vehicle.vehicleName|default(vehicle.vehicleClass) }}" loading="lazy"></div>
                            <div class="cc-media-card__content"><h3>{{ vehicle.vehicleName|default(vehicle.vehicleClass) }}</h3><span class="cc-media-card__class">{{ vehicle.vehicleClass }}</span><div class="cc-media-card__stats"><div><strong>{{ (vehicle.secondsUsed|default(0) / 60)|round(0, 'ceil') }} min</strong><span>en ús</span></div>{% if vehicle.distanceMeters is defined %}<div><strong>{% if vehicle.distanceMeters >= 1000 %}{{ (vehicle.distanceMeters / 1000)|number_format(1, ',', '.') }} km{% else %}{{ vehicle.distanceMeters|round }} m{% endif %}</strong><span>recorregut</span></div>{% endif %}<div><strong>{{ vehicle.kills|default(0) }}</strong><span>baixes</span></div></div></div>
                        </article>
                    {% else %}<p class="cc-media-card__empty">No hi ha vehicles registrats.</p>{% endfor %}
                </div>
            </section>

            {% if data.destroyedVehicles|default([]) is not empty %}
                <section class="cc-section cc-loadout__group">
                    <div class="cc-loadout__heading"><span class="cc-loadout__eyebrow">Vehicles destruïts</span></div>
                    <div class="cc-media-grid">
                        {% for vehicle in data.destroyedVehicles %}
                            <article class="cc-media-card">
                                <div class="cc-media-card__image"><img src="{{ path('cc_composite_field_reports_media', {code: report.code, kind: 'vehicle', assetClass: vehicle.vehicleClass}) }}" alt="{{ vehicle.vehicleName|default(vehicle.vehicleClass) }}" loading="lazy"></div>
                                <div class="cc-media-card__content"><h3>{{ vehicle.vehicleName|default(vehicle.vehicleClass) }}</h3><span class="cc-media-card__class">{{ vehicle.side|default(vehicle.vehicleClass) }}</span><div class="cc-media-card__stats"><div><strong>{{ vehicle.destroyed|default(0) }}</strong><span>destruïts</span></div>{% if vehicle.friendlyLosses|default(0) > 0 %}<div><strong>{{ vehicle.friendlyLosses }}</strong><span>propis</span></div>{% endif %}</div></div>
                            </article>
                        {% endfor %}
                    </div>
                </section>
            {% endif %}
        </div>
    </div>

    {% if report.images is not empty %}
        <section class="cc-section cc-mission-gallery" style="margin-top: 2rem; width: 100%;">
            <div class="cc-mission-gallery__header">
                <div>
                    <h2 class="text-xl font-bold text-white flex items-center gap-2" style="font-family: var(--cdc-font-display, 'Oswald'), 'Barlow Condensed', Impact, sans-serif; letter-spacing: 0.03em; text-transform: uppercase;">
                        <i class="ph ph-images" style="color: #e5ac00;"></i> Fotografies de la Missió ({{ report.images|length }})
                    </h2>
                    <p class="text-secondary text-sm mb-0">Imatges i captures preses durant aquesta operació.</p>
                </div>
                <a href="{{ path('cc_composite_galeria', { mission: report.code }) }}" class="btn-secondary btn-small">
                    <i class="ph ph-arrow-square-out"></i> Veure a la Galeria
                </a>
            </div>
            <div class="cc-mission-gallery__grid">
                {% for img in report.images %}
                    <div style="display: flex; flex-direction: column; border-radius: 10px; overflow: hidden; background: rgba(13, 20, 32, 0.85); border: 1px solid rgba(229, 172, 0, 0.2); box-shadow: 0 4px 16px rgba(0,0,0,0.3);">
                        <a href="{{ path('cc_composite_galeria', { mission: report.code }) }}" style="display: block; text-decoration: none; width: 100%;">
                            <div style="width: 100%; aspect-ratio: 16 / 9; overflow: hidden; background: #080c14;">
                                <img src="{{ asset(img.imagePath, 'cc_composite.asset') }}" alt="{{ img.title|default('Foto de missió') }}" style="width: 100%; height: 100%; object-fit: cover; display: block;" loading="lazy">
                            </div>
                            <div style="padding: 0.85rem 1rem; display: flex; justify-content: space-between; align-items: center; gap: 0.5rem; background: rgba(10, 14, 23, 0.95); border-top: 1px solid rgba(255,255,255,0.06);">
                                <strong style="font-size: 0.92rem; color: #f3f4f6; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                    {{ img.title|default('Fotografia') }}
                                </strong>
                                <span style="font-size: 0.78rem; color: #9ca3af; white-space: nowrap;">
                                    {{ img.createdAt|date('d/m/Y') }}
                                </span>
                            </div>
                        </a>
                    </div>
                {% endfor %}
            </div>
        </section>
    {% endif %}

    <footer class="cc-field__source">
        <span>Mapa topogràfic: <a href="https://atlas.plan-ops.fr/maps/arma3" target="_blank" rel="noopener noreferrer">PLANOPS Atlas</a> · {{ data.mapAttribution|default('Contingut cartogràfic © Bohemia Interactive') }}</span>
        <a href="{{ report.sourceUrl }}" target="_blank" rel="noopener noreferrer"><i class="ph ph-arrow-square-out"></i> Informe original</a>
    </footer>
</article>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script src="https://atlas.plan-ops.fr/lib/leaflet/leaflet.js"></script>
<script src="https://atlas.plan-ops.fr/js/map-utils.js"></script>
<script>
document.querySelectorAll('[data-cc-tiled-map]').forEach(function (mapElement) {
    if (!window.L || !window.GameMapUtils) return;
    var config = JSON.parse(mapElement.dataset.mapConfig);
    var map = GameMapUtils.basicInit(config, mapElement.id);
    map.fitBounds([[0, 0], [config.sizeInMeters, config.sizeInMeters]], { padding: [12, 12] });
    var pointData = mapElement.parentElement.querySelector('[data-map-points]');
    var timedLayers = [];

    pointData.querySelectorAll('[data-map-point]').forEach(function (point) {
        var kind = point.dataset.kind;
        var options = { weight: 1.5, fillOpacity: .72 };
        if (kind === 'movement') options = { radius: Math.min(13, 4 + Number(point.dataset.weight || 1)), color: '#6faeff', fillColor: '#3f8ce8', weight: 1, fillOpacity: .38 };
        if (kind === 'death') options = { radius: 7, color: '#ffd0d2', fillColor: '#e8434b', weight: 2, fillOpacity: .72 };
        if (kind === 'kill') options = { radius: 5, color: '#ffffff', fillColor: '#e5ac00', weight: 1, fillOpacity: 1 };
        var markerColors = { ColorRed: '#ba3b2b', ColorOrange: '#d6960d', ColorYellow: '#e5ac00', ColorGreen: '#4b8f4b', ColorBlue: '#3f8ce8', ColorPink: '#edb8c9', ColorWEST: '#3f8ce8', ColorEAST: '#ba3b2b', ColorGUER: '#4b8f4b', Default: '#ffffff' };
        var markerColor = /^#[0-9a-f]{6}$/i.test(point.dataset.color || '') ? point.dataset.color : (markerColors[point.dataset.color] || '#ffffff');
        if (kind === 'marker') options = { radius: 6, color: markerColor, fillColor: markerColor, weight: 2, fillOpacity: .9 };

        var layer;
        if (kind === 'marker' && point.dataset.shape === 'POLYLINE') {
            var coordinates = [];
            try { coordinates = JSON.parse(point.dataset.polyline || '[]'); } catch (error) { coordinates = []; }
            var latLngs = [];
            for (var index = 0; index + 1 < coordinates.length; index += 2) {
                latLngs.push([Number(coordinates[index + 1]), Number(coordinates[index])]);
            }
            if (latLngs.length < 2) return;
            layer = L.polyline(latLngs, { color: markerColor, weight: 3, opacity: Math.max(0, Math.min(1, Number(point.dataset.alpha || 1))) });
        } else if (kind === 'marker' && (point.dataset.shape === 'RECTANGLE' || point.dataset.shape === 'ELLIPSE')) {
            var centerX = Number(point.dataset.x), centerY = Number(point.dataset.y);
            var sizeA = Math.max(1, Number(point.dataset.sizeA || 1)), sizeB = Math.max(1, Number(point.dataset.sizeB || 1));
            var angle = Number(point.dataset.direction || 0) * Math.PI / 180;
            var geometry = [], steps = point.dataset.shape === 'ELLIPSE' ? 40 : 4;
            for (var step = 0; step < steps; step++) {
                var dx, dy;
                if (point.dataset.shape === 'ELLIPSE') {
                    var theta = step / steps * Math.PI * 2;
                    dx = Math.cos(theta) * sizeA; dy = Math.sin(theta) * sizeB;
                } else {
                    var corners = [[-sizeA, -sizeB], [sizeA, -sizeB], [sizeA, sizeB], [-sizeA, sizeB]];
                    dx = corners[step][0]; dy = corners[step][1];
                }
                geometry.push([centerY + dx * Math.sin(angle) + dy * Math.cos(angle), centerX + dx * Math.cos(angle) - dy * Math.sin(angle)]);
            }
            var alpha = Math.max(0, Math.min(1, Number(point.dataset.alpha || 1)));
            var solid = (point.dataset.brush || '').toUpperCase().indexOf('SOLID') !== -1;
            layer = L.polygon(geometry, { color: markerColor, weight: 2, opacity: alpha, fillColor: markerColor, fillOpacity: solid ? alpha * .25 : 0 });
        } else if (kind === 'marker' && point.dataset.shape === 'ICON' && point.dataset.markerIcon) {
            var markerNode = document.createElement('div');
            markerNode.className = 'cc-arma-marker';
            markerNode.style.opacity = String(Math.max(0, Math.min(1, Number(point.dataset.alpha || 1))));
            var markerImage = document.createElement('img');
            markerImage.src = point.dataset.markerIcon;
            markerImage.alt = '';
            markerImage.style.transform = 'rotate(' + Number(point.dataset.direction || 0) + 'deg)';
            markerNode.appendChild(markerImage);
            if (point.dataset.title) {
                var markerLabel = document.createElement('span');
                markerLabel.textContent = point.dataset.title;
                markerNode.appendChild(markerLabel);
            }
            layer = L.marker([Number(point.dataset.y), Number(point.dataset.x)], { icon: L.divIcon({ className: '', html: markerNode.outerHTML, iconSize: [140, 32], iconAnchor: [12, 16] }), interactive: false });
        } else {
            layer = L.circleMarker([Number(point.dataset.y), Number(point.dataset.x)], options);
        }
        var title = point.dataset.title || point.dataset.markerType || (kind === 'marker' ? 'Marca' : '');
        if (point.dataset.author) title += (title ? ' · ' : '') + point.dataset.author;
        if (title) layer.bindTooltip(title);
        if (point.dataset.profileUrl) {
            layer.on('click', function () { window.location.href = point.dataset.profileUrl; });
        }
        layer.addTo(map);
        if (point.dataset.eventTime !== undefined) {
            timedLayers.push({ time: Number(point.dataset.eventTime), layer: layer, visible: true });
        }
    });

    var timeline = mapElement.parentElement.querySelector('[data-map-time]');
    var timelineLabel = mapElement.parentElement.querySelector('[data-map-time-label]');
    function formatTime(seconds) {
        seconds = Math.max(0, Number(seconds) || 0);
        return String(Math.floor(seconds / 60)).padStart(2, '0') + ':' + String(Math.floor(seconds % 60)).padStart(2, '0');
    }
    function filterTimeline() {
        var cutoff = Number(timeline.value);
        timedLayers.forEach(function (item) {
            var shouldShow = item.time <= cutoff;
            if (shouldShow && !item.visible) { item.layer.addTo(map); item.visible = true; }
            if (!shouldShow && item.visible) { item.layer.removeFrom(map); item.visible = false; }
        });
        timelineLabel.value = formatTime(cutoff);
        timelineLabel.textContent = formatTime(cutoff);
    }
    timeline.addEventListener('input', filterTimeline);
    filterTimeline();
});
document.querySelectorAll('[data-cc-interactive-map]').forEach(function (mapElement) {
    var stage = mapElement.querySelector('[data-map-stage]');
    var timeline = mapElement.parentElement.querySelector('[data-map-time]');
    var timelineLabel = mapElement.parentElement.querySelector('[data-map-time-label]');
    var scale = 1, x = 0, y = 0, dragging = false, startX = 0, startY = 0;
    function renderTransform() { stage.style.transform = 'translate3d(' + x + 'px,' + y + 'px,0) scale(' + scale + ')'; }
    function zoom(nextScale) { scale = Math.max(1, Math.min(5, nextScale)); if (scale === 1) { x = 0; y = 0; } renderTransform(); }
    mapElement.querySelectorAll('[data-map-zoom]').forEach(function (button) {
        button.addEventListener('click', function () {
            if (button.dataset.mapZoom === 'reset') { scale = 1; x = 0; y = 0; renderTransform(); return; }
            zoom(scale + (button.dataset.mapZoom === 'in' ? .5 : -.5));
        });
    });
    mapElement.addEventListener('wheel', function (event) { event.preventDefault(); zoom(scale + (event.deltaY < 0 ? .25 : -.25)); }, { passive: false });
    mapElement.addEventListener('pointerdown', function (event) {
        if (event.target.closest('button') || scale <= 1) return;
        dragging = true; startX = event.clientX - x; startY = event.clientY - y;
        mapElement.classList.add('is-dragging'); mapElement.setPointerCapture(event.pointerId);
    });
    mapElement.addEventListener('pointermove', function (event) { if (dragging) { x = event.clientX - startX; y = event.clientY - startY; renderTransform(); } });
    function stopDragging() { dragging = false; mapElement.classList.remove('is-dragging'); }
    mapElement.addEventListener('pointerup', stopDragging); mapElement.addEventListener('pointercancel', stopDragging);
    function formatLegacyTime(seconds) { seconds = Math.max(0, Number(seconds) || 0); return String(Math.floor(seconds / 60)).padStart(2, '0') + ':' + String(Math.floor(seconds % 60)).padStart(2, '0'); }
    function filterLegacyTimeline() {
        var cutoff = Number(timeline.value);
        mapElement.querySelectorAll('[data-event-time]').forEach(function (point) { point.hidden = Number(point.dataset.eventTime) > cutoff; });
        timelineLabel.value = formatLegacyTime(cutoff); timelineLabel.textContent = formatLegacyTime(cutoff);
    }
    if (timeline) { timeline.addEventListener('input', filterLegacyTimeline); filterLegacyTimeline(); }
});
document.querySelectorAll('[data-feed-players-only]').forEach(function (toggle) {
    var section = toggle.closest('.cc-section');
    var feed = section ? section.querySelector('[data-kill-feed]') : null;
    if (!feed) return;
    var rows = Array.from(feed.querySelectorAll('.cc-feed__row'));
    var empty = feed.querySelector('[data-feed-empty]');
    function filterFeed() {
        var visible = 0;
        rows.forEach(function (row) {
            var show = !toggle.checked || row.dataset.playerInvolved === '1';
            row.hidden = !show;
            if (show) visible++;
        });
        if (empty) empty.classList.toggle('is-visible', visible === 0);
        feed.scrollTop = 0;
    }
    toggle.addEventListener('change', filterFeed);
    filterFeed();
});
document.querySelectorAll('.cc-logistics').forEach(function (layout) {
    var frago = layout.querySelector('[data-frago-panel]');
    var loadout = layout.querySelector('[data-loadout-panel]');
    if (!frago || !loadout) return;
    function syncFragoHeight() {
        frago.style.height = window.innerWidth > 1000 ? Math.ceil(loadout.getBoundingClientRect().height) + 'px' : '';
    }
    if (window.ResizeObserver) {
        new ResizeObserver(syncFragoHeight).observe(loadout);
    }
    window.addEventListener('resize', syncFragoHeight);
    syncFragoHeight();
});
</script>
{% endblock %}
