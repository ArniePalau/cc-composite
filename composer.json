{
    "name": "arniepalau/cc-composite",
    "description": "Layered PERSCOM soldier composite images for forumify.",
    "type": "forumify-plugin",
    "license": "OSL-3.0",
    "require": {
        "php": ">=8.4",
        "ext-gd": "*",
        "forumify/forumify-platform": "^1.0",
        "forumify/forumify-perscom-plugin": "^2.2.8"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "ArniePalau\\CcComposite\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ArniePalau\\CcComposite\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "symfony/flex": false,
            "symfony/runtime": false
        },
        "sort-packages": true
    },
    "extra": {
        "forumify-plugin-class": "ArniePalau\\CcComposite\\CcCompositePlugin"
    }
}
